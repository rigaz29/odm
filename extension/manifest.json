{
  "manifest_version": 3,
  "name": "ODM Integration",
  "version": "1.0.0",
  "description": "Send browser downloads and detected videos to Ochi Download Manager.",
  "key": "",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "nativeMessaging",
    "cookies",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ODM",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "odm@troke.id",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "authenticationInfo"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "medialist.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
